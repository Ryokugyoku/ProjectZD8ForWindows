<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ProjectZD8ForWindows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="RevTorque Insight">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ログイン画面のタイトルバー（シェルを出している間は、シェルが自分のタイトルバーを持つので隠す） -->
        <Grid x:Name="AppTitleBar" Padding="16,0,0,0" ColumnSpacing="10" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xEC4A;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="RevTorque Insight" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
        </Grid>

        <Border x:Name="ContentHost" Grid.Row="1" />
    </Grid>
</Window>
