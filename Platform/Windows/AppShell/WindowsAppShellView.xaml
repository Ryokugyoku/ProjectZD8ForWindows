<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ProjectZD8ForWindows.Platform.Windows.AppShell.WindowsAppShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- iOS 版の macOS サイドバーの代わりに、Windows 標準の NavigationView（左のペイン）を使う。 -->
    <NavigationView
        x:Name="Navigation"
        PaneDisplayMode="Left"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        IsPaneToggleButtonVisible="True"
        OpenPaneLength="292"
        CompactModeThresholdWidth="720"
        ExpandedModeThresholdWidth="1000"
        SelectionChanged="OnSelectionChanged">

        <NavigationView.PaneHeader>
            <Grid Padding="12,4,8,4" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="40" Height="40">
                    <Border CornerRadius="11" BorderThickness="1" BorderBrush="{ThemeResource RevTorqueAccentStrokeBrush}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF04131F" Offset="0" />
                                <GradientStop Color="#FF06263B" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <FontIcon Glyph="&#xEC4A;" FontSize="18" Foreground="#FF05C7E6" />
                    <Ellipse Width="5" Height="5" Fill="#FFFF9F2E" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,9,0" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="RevTorque Insight" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="BrandTagline" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" CharacterSpacing="80" />
                </StackPanel>
            </Grid>
        </NavigationView.PaneHeader>

        <NavigationView.PaneFooter>
            <Border x:Name="FooterCard" Margin="12,8,12,12" Padding="10" CornerRadius="10" Background="{ThemeResource RevTorqueQuietFillBrush}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE734;" FontSize="13" Foreground="{ThemeResource RevTorqueAccentBrush}" />
                    <TextBlock x:Name="FooterCaption" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords" MaxWidth="220" />
                </StackPanel>
            </Border>
        </NavigationView.PaneFooter>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- 既定のアダプターが近くに来たときに接続を尋ねる（iOS 版のローカル通知の代わり）。 -->
            <InfoBar
                x:Name="AdapterArrivalBar"
                Severity="Informational"
                IsClosable="True"
                IsOpen="False"
                Margin="24,12,24,0"
                CloseButtonClick="OnAdapterArrivalDismissed">
                <InfoBar.ActionButton>
                    <Button x:Name="AdapterArrivalConnectButton" Style="{StaticResource AccentButtonStyle}" Click="OnAdapterArrivalAccepted" />
                </InfoBar.ActionButton>
            </InfoBar>
            <Border x:Name="DestinationHost" Grid.Row="1" />
        </Grid>
    </NavigationView>
</UserControl>
