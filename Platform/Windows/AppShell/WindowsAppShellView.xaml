<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ProjectZD8ForWindows.Platform.Windows.AppShell.WindowsAppShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      サインイン後のシェル（docs/UI_GUIDELINES.md の「シェル」）。
      - 1 行目はタイトルバーまで伸ばしたカスタムのタイトルバー：戻る・ナビの開閉・ブランド・接続コンソール（全画面共通の接続・切断・ライブ表示）。
      - 2 行目は NavigationView。表示の形は幅クラスで決める（Wide/Expanded：題つきのペイン、Medium：記号だけのレール、Compact：ハンバーガーで重ねて開く）。
      - 画面の中の階層（履歴の一覧 → 詳細 → 分析）は、タイトルバーの戻る・Alt+←・マウスの戻るボタンで 1 段戻れる。
    -->
    <Grid x:Name="ShellRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- タイトルバー（ドラッグできる領域。ボタンとコンソールだけは押せるように外す） -->
        <Grid x:Name="TitleBar" Background="Transparent" Padding="4,0,0,0" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="CaptionInsetColumn" Width="138" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button
                    x:Name="BackButton"
                    Style="{StaticResource ChromeButtonStyle}"
                    Visibility="Collapsed"
                    Click="OnBackButtonClicked"
                    AutomationProperties.AutomationId="windows-shell-back">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <Button
                    x:Name="PaneToggleButton"
                    Style="{StaticResource ChromeButtonStyle}"
                    Click="OnPaneToggleClicked"
                    AutomationProperties.AutomationId="windows-shell-pane-toggle">
                    <FontIcon Glyph="&#xE700;" FontSize="14" />
                </Button>
            </StackPanel>

            <!-- ブランド：紺のタイルにシアンの記号とオレンジの点（アプリアイコンと同じ色の組） -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="6,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                <Grid Width="24" Height="24">
                    <Border CornerRadius="7" BorderThickness="1" BorderBrush="{ThemeResource RevTorqueAccentStrokeBrush}" Background="{ThemeResource RevTorqueBrandTileBrush}" />
                    <FontIcon Glyph="&#xEC4A;" FontSize="12" Foreground="{ThemeResource RevTorqueBrandGlyphBrush}" />
                    <Ellipse Width="3" Height="3" Fill="{ThemeResource RevTorqueBrandDotBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0" />
                </Grid>
                <StackPanel x:Name="BrandTexts" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="RevTorque Insight" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="13" VerticalAlignment="Center" />
                    <TextBlock x:Name="BrandTagline" Style="{StaticResource CaptionTextBlockStyle}" FontSize="11" CharacterSpacing="120" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <!-- 接続コンソール：どの画面からでも接続・切断・ライブ表示ができる（ホームでは状態だけを出す） -->
            <Border
                x:Name="ConnectionConsole"
                Grid.Column="3"
                Height="36"
                Margin="8,0,8,0"
                Padding="12,0,2,0"
                CornerRadius="18"
                BorderThickness="1"
                Background="{ThemeResource RevTorqueCardBrush}"
                BorderBrush="{ThemeResource RevTorqueCardStrokeBrush}"
                VerticalAlignment="Center">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="14" Height="14" VerticalAlignment="Center">
                        <Ellipse x:Name="ConnectionHalo" Width="14" Height="14" Opacity="0.28" />
                        <Ellipse x:Name="ConnectionDot" Width="8" Height="8" />
                    </Grid>
                    <TextBlock x:Name="ConnectionName" Grid.Column="1" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="13" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <TextBlock x:Name="ConnectionStatus" Grid.Column="2" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <Button x:Name="OpenLiveButton" Grid.Column="3" Height="30" Padding="10,0,10,0" CornerRadius="15" Click="OnOpenLiveClicked" AutomationProperties.AutomationId="windows-shell-open-live">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE9D9;" FontSize="13" />
                            <TextBlock x:Name="OpenLiveText" VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ConnectionButton" Grid.Column="4" Height="30" Padding="12,0,12,0" CornerRadius="15" Click="OnConnectionButtonClicked" AutomationProperties.AutomationId="windows-shell-connection-action">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="ConnectionButtonIcon" FontSize="13" />
                            <TextBlock x:Name="ConnectionButtonText" VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsBackEnabled="False"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="248"
            SelectionChanged="OnSelectionChanged">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel x:Name="NoticeArea">
                    <!-- 既定のアダプターが近くに来たときに接続を尋ねる（iOS 版のローカル通知の代わり）。 -->
                    <InfoBar
                        x:Name="AdapterArrivalBar"
                        Severity="Informational"
                        IsClosable="True"
                        IsOpen="False"
                        CloseButtonClick="OnAdapterArrivalDismissed">
                        <InfoBar.ActionButton>
                            <Button x:Name="AdapterArrivalConnectButton" Style="{StaticResource AccentButtonStyle}" Click="OnAdapterArrivalAccepted" />
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <!-- 前回の実行が正常に終了しなかったとき、不具合レポートの書き出しを尋ねる（閉じたらこの実行では出さない）。 -->
                    <InfoBar
                        x:Name="PreviousRunBar"
                        Severity="Warning"
                        IsClosable="True"
                        IsOpen="False"
                        CloseButtonClick="OnPreviousRunDismissed">
                        <InfoBar.ActionButton>
                            <Button x:Name="PreviousRunExportButton" Style="{StaticResource AccentButtonStyle}" Click="OnPreviousRunExportClicked" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                </StackPanel>
                <Border x:Name="DestinationHost" Grid.Row="1" />
            </Grid>
        </NavigationView>
    </Grid>
</UserControl>
