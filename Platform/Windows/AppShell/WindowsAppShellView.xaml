<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ProjectZD8ForWindows.Platform.Windows.AppShell.WindowsAppShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      iOS 版の macOS サイドバーの代わりに、Windows 標準の NavigationView（左のペイン）を使う。
      - 項目は 1 行（補足はツールチップ）。設定は Windows の慣習どおりペインの下（フッター）に置く。
      - 画面の中の階層（履歴の一覧 → 詳細 → 分析）は、ペインの戻るボタン・Alt+←・マウスの戻るボタンで戻れる。
    -->
    <NavigationView
        x:Name="Navigation"
        PaneDisplayMode="Left"
        IsBackButtonVisible="Collapsed"
        IsBackEnabled="False"
        IsSettingsVisible="False"
        IsPaneToggleButtonVisible="True"
        IsTitleBarAutoPaddingEnabled="False"
        OpenPaneLength="248"
        CompactModeThresholdWidth="720"
        ExpandedModeThresholdWidth="1080"
        SelectionChanged="OnSelectionChanged"
        BackRequested="OnBackRequested">

        <NavigationView.PaneHeader>
            <Grid Padding="10,2,8,6" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="32" Height="32">
                    <Border CornerRadius="9" BorderThickness="1" BorderBrush="{ThemeResource RevTorqueAccentStrokeBrush}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF04131F" Offset="0" />
                                <GradientStop Color="#FF06263B" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <FontIcon Glyph="&#xEC4A;" FontSize="15" Foreground="#FF05C7E6" />
                    <Ellipse Width="4" Height="4" Fill="#FFFF9F2E" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,7,0" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                    <TextBlock Text="RevTorque Insight" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="BrandTagline" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" CharacterSpacing="60" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </NavigationView.PaneHeader>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 接続バー：どの画面からでも、接続・切断・ライブ表示ができる（ホームでは大きなカードがあるので出さない）。 -->
            <Border
                x:Name="ConnectionBar"
                Padding="20,8,16,8"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="ConnectionDot" Width="10" Height="10" VerticalAlignment="Center" />
                    <TextBlock x:Name="ConnectionName" Grid.Column="1" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" MaxWidth="320" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <TextBlock x:Name="ConnectionStatus" Grid.Column="2" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <Button x:Name="OpenLiveButton" Grid.Column="3" Click="OnOpenLiveClicked" AutomationProperties.AutomationId="windows-shell-open-live">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE9D9;" FontSize="14" />
                            <TextBlock x:Name="OpenLiveText" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ConnectionButton" Grid.Column="4" MinWidth="128" Click="OnConnectionButtonClicked" AutomationProperties.AutomationId="windows-shell-connection-action">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="ConnectionButtonIcon" FontSize="14" />
                            <TextBlock x:Name="ConnectionButtonText" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- 既定のアダプターが近くに来たときに接続を尋ねる（iOS 版のローカル通知の代わり）。 -->
            <StackPanel Grid.Row="1">
                <InfoBar
                    x:Name="AdapterArrivalBar"
                    Severity="Informational"
                    IsClosable="True"
                    IsOpen="False"
                    Margin="24,12,24,0"
                    CloseButtonClick="OnAdapterArrivalDismissed">
                    <InfoBar.ActionButton>
                        <Button x:Name="AdapterArrivalConnectButton" Style="{StaticResource AccentButtonStyle}" Click="OnAdapterArrivalAccepted" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!-- 前回の実行が正常に終了しなかったとき、不具合レポートの書き出しを尋ねる（閉じたらこの実行では出さない）。 -->
                <InfoBar
                    x:Name="PreviousRunBar"
                    Severity="Warning"
                    IsClosable="True"
                    IsOpen="False"
                    Margin="24,12,24,0"
                    CloseButtonClick="OnPreviousRunDismissed">
                    <InfoBar.ActionButton>
                        <Button x:Name="PreviousRunExportButton" Style="{StaticResource AccentButtonStyle}" Click="OnPreviousRunExportClicked" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </StackPanel>
            <Border x:Name="DestinationHost" Grid.Row="2" />
        </Grid>
    </NavigationView>
</UserControl>
