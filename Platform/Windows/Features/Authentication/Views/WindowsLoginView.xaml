<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ProjectZD8ForWindows.Platform.Windows.Features.Authentication.Views.WindowsLoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">

    <!-- ログインは常に暗い外観。色はすべてテーマのトークン（Dark）から引く。 -->
    <Grid x:Name="LayoutRoot" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <!-- 背景：紺の面と、右上を中心にした計器の同心円（シアン）・左下のオレンジの輪 -->
        <Rectangle Fill="{ThemeResource RevTorqueHeroBrush}" IsHitTestVisible="False" />
        <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Width="0" Height="0" IsHitTestVisible="False">
            <Ellipse Width="320" Height="320" Stroke="{ThemeResource RevTorqueAccentStrokeBrush}" StrokeThickness="1" />
            <Ellipse Width="520" Height="520" Stroke="{ThemeResource RevTorqueDividerBrush}" StrokeThickness="1" />
            <Ellipse Width="760" Height="760" Stroke="{ThemeResource RevTorqueDividerBrush}" StrokeThickness="1" StrokeDashArray="2,9" />
        </Grid>
        <Grid HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="0" Height="0" IsHitTestVisible="False">
            <Ellipse Width="420" Height="420" Stroke="{ThemeResource RevTorqueCautionSubtleBrush}" StrokeThickness="6" />
        </Grid>

        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
            <Grid x:Name="Layout" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="IntroColumn" Width="*" />
                    <ColumnDefinition x:Name="PanelColumn" Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 左：ブランドと紹介 -->
                <Grid x:Name="IntroArea" RowSpacing="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="BrandRow" Orientation="Horizontal" Spacing="12">
                        <Grid Width="48" Height="48">
                            <Border CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource RevTorqueAccentStrokeBrush}"
                                    Background="{ThemeResource RevTorqueBrandTileBrush}" />
                            <FontIcon Glyph="&#xEC4A;" FontSize="22" Foreground="{ThemeResource RevTorqueBrandGlyphBrush}" />
                            <Ellipse Width="5" Height="5" Fill="{ThemeResource RevTorqueBrandDotBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" />
                        </Grid>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="RevTorque Insight" Style="{StaticResource CardTitleTextStyle}" />
                            <TextBlock x:Name="Eyebrow" Style="{StaticResource EyebrowTextStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <Grid x:Name="HeroRow" Grid.Row="1" ColumnSpacing="24" RowSpacing="20" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- 回転計：外周・信号色の弧・点線の内周・中央のブランドタイル -->
                        <Grid x:Name="Hero" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Ellipse x:Name="HeroOuter" Stroke="{ThemeResource RevTorqueDividerBrush}" StrokeThickness="12" />
                            <Path x:Name="HeroArc" Stroke="{ThemeResource RevTorqueSignalBrush}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Ellipse x:Name="HeroInner" Stroke="{ThemeResource RevTorqueChartGridBrush}" StrokeThickness="1" StrokeDashArray="2,9" />
                            <Grid x:Name="HeroTile" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border CornerRadius="999" BorderThickness="1" BorderBrush="{ThemeResource RevTorqueAccentStrokeBrush}"
                                        Background="{ThemeResource RevTorqueBrandTileBrush}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="-6">
                                    <TextBlock x:Name="HeroLetter" Text="R" FontWeight="Bold" Foreground="{ThemeResource RevTorqueBrandGlyphBrush}" VerticalAlignment="Center" />
                                    <FontIcon x:Name="HeroPulse" Glyph="&#xE9D9;" Foreground="{ThemeResource RevTorqueBrandGlyphBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Ellipse x:Name="HeroDot" Width="8" Height="8" Fill="{ThemeResource RevTorqueBrandDotBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                            </Grid>
                        </Grid>
                        <StackPanel x:Name="IntroTexts" Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                            <TextBlock x:Name="Title" Style="{StaticResource DisplayTextStyle}" TextWrapping="WrapWholeWords" />
                            <TextBlock x:Name="Subtitle" Style="{StaticResource SecondaryBodyTextStyle}" TextWrapping="WrapWholeWords" MaxWidth="560" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="CapabilitiesHost" Grid.Row="2" MaxWidth="640" HorizontalAlignment="Left" />
                </Grid>

                <!-- 右：サインインの操作（この画面の主役のカード） -->
                <Grid x:Name="PanelHost" Grid.Column="1">
                    <Border x:Name="AuthPanel" Style="{StaticResource HeroCardStyle}" MaxWidth="460" VerticalAlignment="Center">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="PanelEyebrow" Style="{StaticResource EyebrowTextStyle}" />
                                <TextBlock x:Name="PanelTitle" Style="{StaticResource SectionTitleTextStyle}" TextWrapping="WrapWholeWords" />
                                <TextBlock x:Name="PanelSubtitle" Style="{StaticResource SecondaryBodyTextStyle}" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <Rectangle Height="1" Fill="{ThemeResource RevTorqueDividerBrush}" />
                            <StackPanel x:Name="PhaseArea" Spacing="12" />
                            <StackPanel x:Name="TrustRow" Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xEA18;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="TrustText" Style="{StaticResource SecondaryCaptionTextStyle}" />
                            </StackPanel>
                            <TextBlock x:Name="ConsentHint" Style="{StaticResource SecondaryCaptionTextStyle}" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
