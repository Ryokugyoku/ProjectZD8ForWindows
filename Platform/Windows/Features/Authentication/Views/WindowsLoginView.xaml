<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ProjectZD8ForWindows.Platform.Windows.Features.Authentication.Views.WindowsLoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">

    <Grid x:Name="LayoutRoot">
        <!-- 背景：濃い紺のグラデーションと、シアン（右上）・わずかなオレンジ（左下）のぼかし -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF0D0D0F" Offset="0" />
                <GradientStop Color="#FF06090E" Offset="0.55" />
                <GradientStop Color="#FF040506" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>
        <Ellipse Width="760" Height="760" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-420,-300,0" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#3005C7E6" Offset="0" />
                    <GradientStop Color="#0005C7E6" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="640" Height="640" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-320,0,0,-320" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#12FF9F2E" Offset="0" />
                    <GradientStop Color="#00FF9F2E" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="Layout" Padding="40" ColumnSpacing="40" RowSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="IntroColumn" Width="*" />
                    <ColumnDefinition x:Name="PanelColumn" Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 左：ブランドと紹介 -->
                <Grid x:Name="IntroArea" RowSpacing="28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="13">
                        <Grid Width="50" Height="50">
                            <Border CornerRadius="14" BorderThickness="1" BorderBrush="#5205C7E6">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF04131F" Offset="0" />
                                        <GradientStop Color="#FF06263B" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <FontIcon Glyph="&#xEC4A;" FontSize="22" Foreground="#FF05C7E6" />
                            <Ellipse Width="5" Height="5" Fill="#FFFF9F2E" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,11,11,0" />
                        </Grid>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="RevTorque Insight" FontSize="17" FontWeight="Bold" Foreground="White" />
                            <TextBlock x:Name="Eyebrow" FontSize="10" FontWeight="SemiBold" CharacterSpacing="140" Foreground="#FF05C7E6" />
                        </StackPanel>
                    </StackPanel>

                    <Grid x:Name="HeroRow" Grid.Row="1" ColumnSpacing="34" RowSpacing="16" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="Hero" Width="240" Height="240" VerticalAlignment="Center">
                            <Ellipse Stroke="#12FFFFFF" StrokeThickness="16" />
                            <Path x:Name="HeroArc" Stroke="#FF05C7E6" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Ellipse Margin="29" Stroke="#2EFFFFFF" StrokeThickness="1" StrokeDashArray="2,9" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="-6">
                                <TextBlock x:Name="HeroLetter" Text="R" FontWeight="Bold" Foreground="#FF05C7E6" VerticalAlignment="Center" />
                                <FontIcon x:Name="HeroPulse" Glyph="&#xE9D9;" Foreground="#FF05C7E6" VerticalAlignment="Center" />
                            </StackPanel>
                            <Ellipse x:Name="HeroDot" Width="8" Height="8" Fill="#FFFF9F2E" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel x:Name="IntroTexts" Grid.Column="1" Spacing="10" VerticalAlignment="Center">
                            <TextBlock x:Name="Title" FontSize="38" FontWeight="Bold" Foreground="White" TextWrapping="WrapWholeWords" />
                            <TextBlock x:Name="Subtitle" FontSize="15" Foreground="#A8FFFFFF" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Grid>

                    <VariableSizedWrapGrid x:Name="Capabilities" Grid.Row="2" Orientation="Horizontal" ItemHeight="44" />
                </Grid>

                <!-- 右：サインインの操作 -->
                <Border x:Name="AuthPanel" Grid.Column="1" MaxWidth="460" MinWidth="340" Padding="26" CornerRadius="20"
                        Background="#14FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" VerticalAlignment="Center">
                    <StackPanel Spacing="18">
                        <StackPanel Spacing="7">
                            <TextBlock x:Name="PanelEyebrow" FontSize="12" FontWeight="SemiBold" CharacterSpacing="120" Foreground="#FF05C7E6" />
                            <TextBlock x:Name="PanelTitle" Style="{StaticResource SubtitleTextBlockStyle}" Foreground="White" TextWrapping="WrapWholeWords" />
                            <TextBlock x:Name="PanelSubtitle" Style="{StaticResource BodyTextBlockStyle}" Foreground="#9EFFFFFF" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                        <Rectangle Height="1" Fill="#1AFFFFFF" />
                        <StackPanel x:Name="PhaseArea" Spacing="12" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEA18;" FontSize="12" Foreground="#9EFFFFFF" />
                            <TextBlock x:Name="TrustText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="#9EFFFFFF" />
                        </StackPanel>
                        <TextBlock x:Name="ConsentHint" Style="{StaticResource CaptionTextBlockStyle}" Foreground="#73FFFFFF" TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
