<?xml version="1.0" encoding="utf-8"?>
<!--
  上：階層のパンくず（接続履歴 › 車両 › セッション › 解析）。どの段にも 1 クリックで戻れる。
  下：Stage に、車両別のアーカイブ・一覧と詳細（AdaptiveSplit）・解析の 3 つの面を持ち、出し入れは Visibility だけで行う（コードで組む）。
-->
<UserControl
    x:Class="ProjectZD8ForWindows.Platform.Windows.Features.LogHistory.Views.WindowsConnectionHistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <BreadcrumbBar x:Name="Breadcrumb" Visibility="Collapsed" ItemClicked="OnBreadcrumbItemClicked" />

        <Grid x:Name="Stage" Grid.Row="1" />
    </Grid>
</UserControl>
