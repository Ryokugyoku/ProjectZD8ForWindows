<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ProjectZD8ForWindows.Platform.Windows.Features.Maintenance.Views.WindowsMaintenanceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      一覧（時系列。選んだ記録は強調し、↑↓ キーでも選べる。右クリックで編集・削除）と、概要か編集。
      2 つの面は AdaptiveSplit に入れて置く（Expanded 以上で左右、Compact・Medium は片方だけ）。配置はコードビハインドで行う。
    -->
    <Grid x:Name="Root">
        <Border x:Name="TimelinePane" Style="{StaticResource SurfaceCardStyle}" Padding="0">
            <Grid x:Name="Timeline" Padding="16,16,8,12" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel x:Name="TimelineHeader" Spacing="12" Margin="4,0,8,0" />
                <ListView
                    x:Name="RecordList"
                    Grid.Row="1"
                    SelectionMode="Single"
                    IsItemClickEnabled="True"
                    ItemClick="OnRecordClicked"
                    SelectionChanged="OnRecordSelectionChanged" />
                <ContentPresenter x:Name="EmptyHost" Grid.Row="1" VerticalAlignment="Top" Margin="4,0,8,0" />
            </Grid>
        </Border>
        <Border x:Name="DetailHost" />
    </Grid>
</UserControl>
