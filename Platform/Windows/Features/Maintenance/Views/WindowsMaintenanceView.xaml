<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ProjectZD8ForWindows.Platform.Windows.Features.Maintenance.Views.WindowsMaintenanceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      左：整備記録の時系列（選んだ記録は強調し、↑↓ キーでも選べる。右クリックで編集・削除）、右：概要か編集。iOS 版と同じ 2 列の構成。
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" MinWidth="260" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid x:Name="Timeline" Padding="16,16,8,12" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel x:Name="TimelineHeader" Spacing="12" Margin="4,0,8,0" />
                <ListView
                    x:Name="RecordList"
                    Grid.Row="1"
                    SelectionMode="Single"
                    IsItemClickEnabled="True"
                    ItemClick="OnRecordClicked"
                    SelectionChanged="OnRecordSelectionChanged" />
                <ContentPresenter x:Name="EmptyHost" Grid.Row="1" VerticalAlignment="Top" Margin="4,0,8,0" />
            </Grid>
        </Border>
        <Rectangle Grid.Column="1" Width="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <Border x:Name="DetailHost" Grid.Column="2" />
    </Grid>
</UserControl>
