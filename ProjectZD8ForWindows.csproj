<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ProjectZD8ForWindows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <!-- 対応していない表示言語のときは英語で出す（iOS 版の元の言語は日本語だが、海外の利用者に読める言語を優先）。 -->
    <DefaultLanguage>en-US</DefaultLanguage>
    <!-- 単一インスタンスとプロトコル起動の振り分けのため、Main は App/Lifecycle/Program.cs に自分で書く。 -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- 開発者ごとの秘密の設定（Apple の Services ID、CloudKit の API トークン）。あればアプリと一緒に配る。コミットしない（.gitignore）。 -->
  <ItemGroup Condition="Exists('appsettings.Local.json')">
    <Content Include="appsettings.Local.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- src/ と tests/ は別プロジェクト。アプリのビルドに取り込まないよう除外する。.claude/ はエージェントの作業ツリー（リポジトリの複製）が入るので同じく除外する。 -->
  <ItemGroup>
    <Compile Remove="src\**;tests\**;tools\**;scripts\**;.claude\**" />
    <None Remove="src\**;tests\**;tools\**;scripts\**;.claude\**" />
    <Page Remove="src\**;tests\**;tools\**;scripts\**;.claude\**" />
    <Content Remove="src\**;tests\**;tools\**;scripts\**;.claude\**" />
    <PRIResource Remove="src\**;tests\**;tools\**;scripts\**;.claude\**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="src\ProjectZD8.Domain\ProjectZD8.Domain.csproj" />
    <ProjectReference Include="src\ProjectZD8.Application\ProjectZD8.Application.csproj" />
    <ProjectReference Include="src\ProjectZD8.Data\ProjectZD8.Data.csproj" />
    <ProjectReference Include="src\ProjectZD8.Data.Windows\ProjectZD8.Data.Windows.csproj" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <!--
      トリミングはしない。テンプレートの既定（Release で True）のままだと、Store 用のパッケージが起動直後に
      Microsoft.UI.Xaml.dll で落ちる（0xc000027b、2026-11-10 に確認）。System.Text.Json のリフレクション
      （車両・整備記録・CloudKit の JSON）も IL2026 の警告どおり壊れうる。JSON をソース生成に移してから見直す。
    -->
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>
</Project>