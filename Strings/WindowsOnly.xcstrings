{
  "sourceLanguage" : "ja",
  "strings" : {
    "windows.login.continue_local" : {
      "comment" : "Windows 版だけ。アカウントの設定がないローカルモードで、ログイン画面のボタン。",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Continue on this PC" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Continuar en este equipo" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "この PC で続ける" } }
      }
    },
    "windows.login.disclaimer.accept_local" : {
      "comment" : "Windows 版だけ。ローカルモードの免責事項ダイアログの同意ボタン。",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Agree and Continue" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Aceptar y continuar" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "同意して続ける" } }
      }
    },
    "windows.login.apple_coming_soon" : {
      "comment" : "Windows 版だけ。押せない Apple のサインインボタンに付ける印（機能フラグ AppleSignIn:Enabled が無効の間）。",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Coming soon" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Próximamente" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "近日対応" } }
      }
    },
    "windows.cloud.coming_soon" : {
      "comment" : "Windows 版だけ。設定画面の iCloud 同期カード（機能フラグが無効の間）。",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Coming soon: iCloud sync will be available together with Sign in with Apple. Until then, data stays on this PC." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Próximamente: la sincronización con iCloud llegará junto con el inicio de sesión con Apple. Hasta entonces, los datos se quedan en este equipo." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "近日対応：iCloud 同期は、Apple でのサインインと同時に使えるようになります。それまでデータはこの PC の中だけに保存します。" } }
      }
    },
    "windows.login.local_mode_notice" : {
      "comment" : "Windows 版だけ。ローカルモードの説明。",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Sign in with Apple is coming soon. For now, your data is kept only on this PC and isn't synced with iPhone. It will move to your Apple account when you first sign in." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "El inicio de sesión con Apple llegará pronto. Por ahora, tus datos se guardan solo en este equipo y no se sincronizan con el iPhone. Pasarán a tu cuenta de Apple la primera vez que inicies sesión." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Apple でのサインインは近日対応です。今はデータをこの PC の中だけに保存し、iPhone とは同期しません。初めて Apple でサインインしたときに、そのアカウントへ引き継ぎます。" } }
      }
    },
    "settings.windows_cloud.eyebrow" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "ICLOUD" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "ICLOUD" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ICLOUD" } }
      }
    },
    "settings.windows_cloud.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "iCloud sync" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Sincronización con iCloud" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "iCloud 同期" } }
      }
    },
    "settings.windows_cloud.description" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Sign in to iCloud with the same Apple ID as your iPhone to sync vehicles, maintenance records, and drive logs." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Inicia sesión en iCloud con el mismo Apple ID que tu iPhone para sincronizar vehículos, mantenimiento y registros de conducción." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "iPhone と同じ Apple ID で iCloud にサインインすると、車両・整備記録・走行ログを同期します。" } }
      }
    },
    "windows.cloud.signed_in" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Signed in to iCloud" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Sesión iniciada en iCloud" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "iCloud にサインイン済み" } }
      }
    },
    "windows.cloud.signed_out" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Not signed in to iCloud. Data stays on this PC until you sign in." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "No has iniciado sesión en iCloud. Los datos se quedan en este equipo hasta que inicies sesión." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "iCloud にサインインしていません。サインインするまで、データはこの PC の中だけです。" } }
      }
    },
    "windows.cloud.sign_in" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Sign in to iCloud" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Iniciar sesión en iCloud" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "iCloud にサインイン" } }
      }
    },
    "windows.cloud.sign_out" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Sign out of iCloud" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Cerrar sesión en iCloud" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "iCloud からサインアウト" } }
      }
    },
    "windows.cloud.signing_in" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Finish signing in in your browser…" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Termina de iniciar sesión en el navegador…" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ブラウザーでサインインを済ませてください…" } }
      }
    },
    "windows.cloud.sign_in_failed" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Couldn't sign in to iCloud. Try again." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudo iniciar sesión en iCloud. Inténtalo de nuevo." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "iCloud にサインインできませんでした。もう一度お試しください。" } }
      }
    },
    "windows.adapter_prompt.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your default adapter is nearby" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Tu adaptador predeterminado está cerca" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "既定のアダプターが見つかりました" } }
      }
    },
    "windows.adapter_prompt.message" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Connect to %@ and identify the vehicle?" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "¿Conectar con %@ e identificar el vehículo?" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@ に接続して車両を確かめますか？" } }
      }
    },
    "windows.adapter_prompt.connect" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Connect" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Conectar" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "接続" } }
      }
    },
    "windows.adapter_prompt.dismiss" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Not now" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Ahora no" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "あとで" } }
      }
    },
    "windows.shell.connection.connected" : {
      "comment" : "Windows 版だけ。画面上部の接続バー：車両に接続していて、ライブ取得中のとき。",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Connected" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Conectado" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "接続中" } }
      }
    },
    "windows.shell.connection.disconnecting" : {
      "comment" : "Windows 版だけ。画面上部の接続バー：切断の処理中。",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Disconnecting…" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Desconectando…" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "切断しています…" } }
      }
    },
    "windows.shell.open_live" : {
      "comment" : "Windows 版だけ。画面上部の接続バー：リアルタイムログの画面を開くボタン。",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Open live view" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Ver en directo" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ライブを表示" } }
      }
    },
    "windows.maintenance.new" : {
      "comment" : "Windows 版だけ。整備記録の一覧の上の「新規」ボタン（軽整備・重整備を選ぶメニューを開く）。",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "New record" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Nuevo registro" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "新しい記録" } }
      }
    },
    "windows.history.open_detail" : {
      "comment" : "Windows 版だけ。接続履歴のセッションの右クリックメニュー：詳細を開く。",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Open details" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Abrir detalles" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "詳細を開く" } }
      }
    },
    "windows.history.select_session" : {
      "comment" : "Windows 版だけ。接続履歴を 2 列で出すとき、右側にセッションを選ぶ前に出す案内。",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Select a session to see its details here." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Selecciona una sesión para ver sus detalles aquí." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "セッションを選ぶと、ここに詳細が表示されます。" } }
      }
    },
    "windows.settings.group.general" : {
      "comment" : "Windows 版だけ。設定画面の見出し：言語と外観。",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "General" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "General" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "全般" } }
      }
    },
    "windows.settings.group.connection" : {
      "comment" : "Windows 版だけ。設定画面の見出し：アダプター。",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Connection" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Conexión" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "接続" } }
      }
    },
    "windows.settings.group.data" : {
      "comment" : "Windows 版だけ。設定画面の見出し：アップロードと iCloud 同期。",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Data and sync" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Datos y sincronización" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "データと同期" } }
      }
    },
    "windows.settings.group.account" : {
      "comment" : "Windows 版だけ。設定画面の見出し：アカウントの削除。",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Account" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Cuenta" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "アカウント" } }
      }
    },
    "windows.maintenance.delete.title" : {
      "comment" : "Windows 版だけ。整備記録を削除する前の確認ダイアログの題。",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Delete this service record?" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "¿Eliminar este registro de mantenimiento?" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "この整備記録を削除しますか？" } }
      }
    },
    "windows.maintenance.delete.message" : {
      "comment" : "Windows 版だけ。整備記録を削除する前の確認ダイアログの本文。%@ は記録の題。",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“%@” will be deleted. This can't be undone." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Se eliminará «%@». Esta acción no se puede deshacer." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "「%@」を削除します。この操作は取り消せません。" } }
      }
    }
  },
  "version" : "1.0"
}
