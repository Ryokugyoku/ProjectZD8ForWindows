    "windows.diagnostics.clear.confirm.message" : {
      "comment" : "Windows 版だけ。診断ログを消す前の確認ダイアログの本文。",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "All diagnostic logs except those of the current session will be deleted. Connection history, vehicles and service records are not affected. This can't be undone." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Se eliminarán todos los registros de diagnóstico excepto los de la sesión actual. El historial de conexiones, los vehículos y los registros de mantenimiento no se ven afectados. Esta acción no se puede deshacer." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "今の起動のログを除いて、診断ログをすべて消します。接続履歴・車両・整備記録には影響しません。この操作は取り消せません。" } }
      }
    },
    "windows.diagnostics.clear.confirm.action" : {
      "comment" : "Windows 版だけ。診断ログを消す確認ダイアログの実行ボタン。",
