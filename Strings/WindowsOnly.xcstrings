    "windows.diagnostics.clear.confirm.title" : {
      "comment" : "Windows 版だけ。診断ログを消す前の確認ダイアログの題。",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Delete diagnostic logs?" } },
