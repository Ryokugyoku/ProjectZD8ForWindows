<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows の API（シリアル、Bluetooth、資格情報、ブラウザー起動、スリープ抑止）が必要な Data 層の実装。 -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ProjectZD8.Data.Windows</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Platforms>AnyCPU;x86;x64;ARM64</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ProjectZD8.Data\ProjectZD8.Data.csproj" />
    <ProjectReference Include="..\ProjectZD8.Diagnostics\ProjectZD8.Diagnostics.csproj" />
  </ItemGroup>
</Project>
